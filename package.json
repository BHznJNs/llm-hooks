    "openai": "^5.15.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@tailwindcss/vite": "^4.1.12",
