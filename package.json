{
  "name": "llm-hooks",
  "version": "1.0.0",
  "author": {
    "name": "BHznJNs",
    "email": "BHznJNs@outlook.com"
  },
  "type": "module",
  "scripts": {
    "start": "node dist-src/index.js",
    "start:docker": "node --env-file .env.docker dist-src/index.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "tsx --env-file .env src/index.ts",
    "dev:docker": "tsx --env-file .env.docker src/index.ts",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "node scripts/build-backend.js",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "ai": "^5.0.18",
    "drizzle-orm": "^0.44.4",
    "env-paths": "^3.0.0",
    "hono": "^4.9.2",
    "live-plugin-manager": "^1.1.0",
    "llm-hooks-sdk": "^1.1.5",
    "openai": "^5.15.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.9",
    "esbuild-node-externals": "^1.18.0",
    "tsx": "^4.20.4",
    "ultracite": "^5.3.3"
  }
}
